{
  "name": "@arkadia/data",
  "version": "0.3.0",
  "description": "AK-DATA (Arkadia Data Format): a lossless, schema-first JSON alternative that cuts LLM tokens for prompts, tool results and agent memory. The ak-data command line tool is the Rust crate arkadia-data.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "verify": "node scripts/verify-build.js",
    "watch": "tsc -w",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "fix": "biome check --write ."
  },
  "keywords": [
    "arkadia",
    "llm",
    "ai",
    "agents",
    "tokens",
    "json",
    "toon",
    "serialization",
    "prompt",
    "mcp",
    "ak-data"
  ],
  "author": "Arkadia Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arkadia-solutions/arkadia-data.git",
    "directory": "typescript"
  },
  "homepage": "https://arkadia.solutions/akdata",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^20.19.31",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "bugs": {
    "url": "https://github.com/arkadia-solutions/arkadia-data/issues"
  }
}
