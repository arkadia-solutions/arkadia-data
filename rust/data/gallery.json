  {
    "slug": "schema-metadata",
    "title": "Schema and instance metadata",
    "shows": "Metadata on the header ($required, $unit, $maxItems, comments) describes every record; metadata on a value ($verified, #featured, #discontinued) describes one record. Both are skipped when decoding — the JSON is the same — but a model reads them.",
    "question": "Which products are verified and not discontinued? Give the sku and the price in EUR.",
    "answer": {
      "name": "verified",
      "fields": [
        [
          "sku",
          "string"
        ],
        [
          "eur",
          "number"
        ]
      ]
    },
    "expected": [
      {
        "sku": "PROD-123",
        "eur": 89.0
      },
      {
        "sku": "PROD-125",
        "eur": 199.0
      }
    ],
    "akd": "// $source=\"catalogue\" $exported=\"2026-10-30\" #snapshot //\n/* Product catalogue: one named type with schema metadata */\n@Product<[\n  /* Schema metadata: rules for every product */\n  sku:string $required /* stock keeping unit */,\n  name:string $required,\n  price:number $unit=\"EUR\" $min=0,\n  tags:[string] $maxItems=3\n]>\n<products:@Product>\n([\n  /* Instance metadata: facts about one product */\n  $verified=true (\"PROD-123\", \"Keyboard\", 89.0, [\"new\", \"wireless\"]) #featured,\n  (\"PROD-124\", \"Mouse\", 39.5, []),\n  $verified=true (\"PROD-125\", \"Dock\", 199.0, [\"usb-c\"]),\n  (\"PROD-126\", \"Cable\", 9.99, [\"usb-c\"]) #discontinued /* sold out, no restock */\n])",
    "id": 14
  },
