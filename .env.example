# Copy to .env (never committed) for `make release` on your Mac, or set the
# same names as GitHub secrets for .github/workflows/release.yml
# (gh secret set NAME, e.g.: base64 -i cert.p12 | gh secret set APPLE_CERTIFICATE_P12).

# --- macOS signing ----------------------------------------------------------
# "Developer ID Application: Your Name (TEAMID)". Locally, when the
# certificate is in your keychain, this is all you need (empty: the first
# Developer ID Application identity found).
APPLE_SIGNING_IDENTITY=
# Only where the certificate is not in the keychain (CI): the .p12 exported
# from Keychain Access, base64 (base64 -i cert.p12), and its password.
APPLE_CERTIFICATE_P12=
APPLE_CERTIFICATE_PASSWORD=
# Optional: "Developer ID Installer: Your Name (TEAMID)" → also a signed .pkg
# (in CI its certificate must be in the same .p12).
APPLE_INSTALLER_IDENTITY=

# --- macOS notarization: one of the three ------------------------------------
# 1. App Store Connect API key (Users and Access → Integrations): the .p8
#    file's text or its base64, the key id and the issuer id.
APPLE_API_KEY_P8=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# 2. Apple ID with an app-specific password (appleid.apple.com).
APPLE_ID=
APPLE_APP_PASSWORD=
APPLE_TEAM_ID=
# 3. Locally only: a profile saved with `xcrun notarytool store-credentials NAME`.
APPLE_NOTARY_PROFILE=

# --- publishing (GitHub secrets for the release workflow) ---------------------
# A token that can push to arkadia-solutions/homebrew-tap (contents: write).
HOMEBREW_TAP_TOKEN=
# crates.io API token (publish-update scope).
CARGO_REGISTRY_TOKEN=
